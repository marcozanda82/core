<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only in produzione (Firebase, API cloud).
  Cleartext disabilitato: usesCleartextTraffic=false su <application>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
