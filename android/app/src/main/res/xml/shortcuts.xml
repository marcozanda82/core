<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Ok Google / App Actions: "aggiungi una mela a Kentu"
      BII CREATE_THING → deep link kentu://app/add_draft?text=...
    -->
    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.marcozanda.kentuos"
            android:targetClass="com.marcozanda.kentuos.MainActivity">
            <url-template android:value="kentu://app/add_draft{?text}" />
            <parameter
                android:name="thing.name"
                android:key="text"
                android:mimeType="text/*" />
        </intent>
    </capability>
</shortcuts>
