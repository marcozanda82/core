<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kentu_splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kentu_splash_background"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="noHideDescendants">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/kentu_symbol_stage"
            android:layout_width="216dp"
            android:layout_height="216dp">

            <com.marcozanda.kentuos.splash.EnsoDrawView
                android:id="@+id/kentu_enso_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/kentu_k_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleX="0.92"
                android:scaleY="0.92"
                android:src="@drawable/kentu_k" />

            <TextView
                android:id="@+id/kentu_os_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="132dp"
                android:layout_marginTop="70dp"
                android:alpha="0"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:letterSpacing="0.02"
                android:text="@string/kentu_wordmark_os"
                android:textColor="@color/kentu_enso_blue"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/kentu_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:translationX="-12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/kentu_wordmark_kentu"
                android:textColor="@color/kentu_k_white"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/kentu_wordmark_os"
                android:textColor="@color/kentu_enso_blue"
                android:textSize="13sp"
                android:translationY="-7dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
