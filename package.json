    "verify:gemini-http-parity": "node scripts/verifyGeminiHttpParity.mjs",
    "sync:focus-functions": "node scripts/syncFocusForFunctions.mjs",
    "prepare:focus-functions": "node scripts/prepareFocusFunctionsPackage.mjs",
    "smoke:focus-functions": "node scripts/syncFocusForFunctions.mjs && node scripts/verifyGeminiHttpParity.mjs && node functions/smokeFocusPackage.cjs",
    "test:focus:i4c": "firebase emulators:exec --only \"auth,database\" --project demo-kentu-focus \"node --test --test-concurrency=1 src/features/kentuFocus/server/__tests__/focusAdmin.i4c.test.js src/features/kentuFocus/server/__tests__/focusRules.i4c.test.js\"",
    "test:focus:i4e": "firebase emulators:exec --only \"auth,database\" --project demo-kentu-focus \"node --test --test-concurrency=1 src/features/kentuFocus/server/__tests__/focusPipeline.i4e.test.js\"",
    "test:focus:i4f": "firebase emulators:exec --only \"auth,database\" --project demo-kentu-focus \"node --test --test-concurrency=1 src/features/kentuFocus/server/__tests__/focusPipeline.i4f.test.js\"",
    "test:focus:i4g": "firebase emulators:exec --only \"auth,database\" --project demo-kentu-focus \"node --test --test-concurrency=1 src/features/kentuFocus/server/__tests__/focusAdmin.i4g.test.js\"",
    "focus:admin-generate": "node scripts/focusAdminGenerateEdition.mjs",
    "focus:pilot-find-last-night": "node scripts/focusPilotFindLastNight.mjs"
