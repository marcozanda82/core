# KentuOS / GhostApp — variabili Vite (prefisso VITE_ obbligatorio)
# Copia in `.env` o `.env.local` e compila i valori del tuo progetto Firebase.
# Senza questo file l'app usa i fallback in src/firebaseConfig.js e firebaseAuth.js.

# Firebase web config (Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google OAuth Web Client ID (client_type 3) — non usare gli ID Android
VITE_GOOGLE_WEB_CLIENT_ID=
