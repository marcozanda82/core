{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid",
        "ui_preferences": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid",
          "focusTheme": {
            ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'system' || newData.val() === 'light' || newData.val() === 'dark'))"
          }
        }
      }
    },
    "planning": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "weeklyPlanning": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "kentu_focus": {
      "$uid": {
        ".read": false,
        ".write": false,
        "editions": {
          "$publicationDate": {
            ".read": false,
            ".write": false,
            "meta": {
              ".read": "$uid === auth.uid && (data.child('status').val() === 'published' || data.child('status').val() === 'published_fallback')",
              ".write": false
            },
            "rev": {
              "$revision": {
                ".read": "$uid === auth.uid && root.child('kentu_focus').child($uid).child('editions').child($publicationDate).child('meta').child('currentRevision').val() + '' === $revision && (root.child('kentu_focus').child($uid).child('editions').child($publicationDate).child('meta').child('status').val() === 'published' || root.child('kentu_focus').child($uid).child('editions').child($publicationDate).child('meta').child('status').val() === 'published_fallback')",
                ".write": false
              }
            },
            "memory_events": {
              "$revision": {
                ".read": false,
                ".write": false
              }
            }
          }
        },
        "archive_index": {
          ".read": "$uid === auth.uid",
          ".write": false
        },
        "jobs": {
          ".read": false,
          ".write": false
        },
        "dossiers": {
          ".read": false,
          ".write": false
        },
        "editorial_memory": {
          ".read": false,
          ".write": false
        }
      }
    },
    "logs": {
      "system_errors": {
        "$pushId": {
          ".read": false,
          ".write": "!data.exists() && auth != null && newData.child('uid').val() === auth.uid && newData.hasChildren(['timestamp', 'uid', 'error', 'context']) && newData.child('error').isString() && newData.child('error').val().length() <= 2000 && newData.child('context').isString() && newData.child('context').val().length() <= 200 && (!newData.hasChild('code') || (newData.child('code').isString() && newData.child('code').val().length() <= 200)) && (!newData.hasChild('details') || (newData.child('details').isString() && newData.child('details').val().length() <= 4000)) && (!newData.hasChild('route') || (newData.child('route').isString() && newData.child('route').val().length() <= 300)) && newData.child('timestamp').val() === now"
        }
      }
    }
  }
}
